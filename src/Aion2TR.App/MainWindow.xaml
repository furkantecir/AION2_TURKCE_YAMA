<Window x:Class="Aion2TR.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Aion2TR.App"
        mc:Ignorable="d"
        Title="AION2TR - Oyun Başlatıcı &amp; Türkçe Yama"
        Icon="pack://application:,,,/Assets/Icons/app_icon.ico"
        Width="1000" Height="620"
        MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        Loaded="MainWindow_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        FontFamily="Plus Jakarta Sans, Segoe UI Variable, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Brand Serif Font Definition -->
        <FontFamily x:Key="BrandFont">Cinzel, Palatino Linotype, Georgia, serif</FontFamily>
        <FontFamily x:Key="MonoFont">Consolas, Cascadia Mono, Courier New, monospace</FontFamily>

        <!-- SVG Geometries -->
        <PathGeometry x:Key="GithubIcon" Figures="M12,2 C6.477,2 2,6.484 2,12.017 C2,16.442 4.865,20.197 8.839,21.521 C9.339,21.613 9.521,21.304 9.521,21.038 C9.521,20.801 9.513,20.17 9.508,19.335 C6.726,19.94 6.139,17.992 6.139,17.992 C5.685,16.834 5.029,16.526 5.029,16.526 C4.121,15.906 5.098,15.918 5.098,15.918 C6.101,15.988 6.628,16.95 6.628,16.95 C7.52,18.48 8.969,18.038 9.538,17.782 C9.63,17.135 9.888,16.694 10.174,16.444 C7.954,16.191 5.619,15.331 5.619,11.493 C5.619,10.4 6.009,9.505 6.648,8.805 C6.545,8.552 6.202,7.533 6.746,6.155 C6.746,6.155 7.586,5.885 9.496,7.181 C10.294,6.959 11.149,6.848 12,6.844 C12.85,6.848 13.705,6.959 14.504,7.181 C16.413,5.885 17.251,6.155 17.251,6.155 C17.797,7.533 17.453,8.552 17.351,8.805 C17.991,9.505 18.379,10.4 18.379,11.493 C18.379,15.341 16.04,16.188 13.813,16.436 C14.172,16.745 14.491,17.356 14.491,18.291 C14.491,19.629 14.479,20.71 14.479,21.038 C14.479,21.306 14.659,21.618 15.167,21.52 C19.138,20.194 22,16.44 22,12.017 C22,6.484 17.522,2 12,2 Z" />
        <PathGeometry x:Key="LogsIcon" Figures="M19.5,14.25 V11.625 C19.5,9.761 17.989,8.25 16.125,8.25 H14.625 C14.004,8.25 13.5,7.746 13.5,7.125 V5.625 C13.5,3.761 11.989,2.25 10.125,2.25 H8.25 M8.25,15 H15.75 M8.25,18 H12 M10.5,2.25 H5.625 C5.004,2.25 4.5,2.754 4.5,3.375 V20.625 C4.5,21.246 5.004,21.75 5.625,21.75 H18.375 C18.996,21.75 19.5,21.246 19.5,20.625 V11.25" />
        <PathGeometry x:Key="SettingsIcon" Figures="M9.594,3.94 C9.684,3.398 10.154,3 10.704,3 H13.297 C13.847,3 14.317,3.398 14.407,3.94 L14.62,5.221 C14.683,5.595 14.933,5.907 15.265,6.091 C15.339,6.131 15.412,6.174 15.485,6.218 C15.809,6.414 16.205,6.475 16.56,6.342 L17.777,5.886 C18.288,5.694 18.868,5.913 19.147,6.376 L20.443,8.623 C20.718,9.099 20.608,9.703 20.183,10.054 L19.18,10.881 C18.887,11.121 18.742,11.494 18.749,11.873 C18.756,12.251 18.901,12.624 19.194,12.864 L20.199,13.692 C20.623,14.042 20.733,14.646 20.459,15.122 L19.161,17.369 C18.882,17.832 18.302,18.051 17.791,17.859 L16.574,17.403 C16.219,17.27 15.824,17.331 15.498,17.527 C15.425,17.571 15.352,17.614 15.278,17.654 C14.947,17.837 14.697,18.149 14.634,18.523 L14.421,19.803 C14.331,20.346 13.861,20.744 13.311,20.744 H10.717 C10.167,20.744 9.697,20.346 9.607,19.803 L9.394,18.522 C9.332,18.148 9.082,17.836 8.75,17.652 C8.677,17.612 8.604,17.569 8.531,17.525 C8.206,17.329 7.81,17.268 7.455,17.401 L6.238,17.857 C5.727,18.049 5.147,17.83 4.868,17.367 L3.571,15.12 C3.296,14.644 3.406,14.04 3.831,13.689 L4.835,12.862 C5.127,12.622 5.272,12.249 5.265,11.87 C5.258,11.492 5.113,11.119 4.82,10.879 L3.816,10.051 C3.392,9.701 3.282,9.097 3.556,8.621 L4.853,6.374 C5.132,5.911 5.712,5.692 6.223,5.884 L7.439,6.34 C7.795,6.473 8.19,6.412 8.516,6.216 C8.588,6.172 8.662,6.129 8.736,6.088 C9.068,5.905 9.318,5.593 9.38,5.219 Z M12,9 A3,3 0 1,0 12,15 A3,3 0 1,0 12,9" />
        <PathGeometry x:Key="PlayIcon" Figures="M7,4.5 V19.5 L19,12 Z" />
        <PathGeometry x:Key="MinimizeIcon" Figures="M4,12 H20" />
        <PathGeometry x:Key="CloseIcon" Figures="M6,18 L18,6 M6,6 L18,18" />

        <!-- Startup Intro Storyboard (1.20s max duration, restrained and cinematic) -->
        <Storyboard x:Key="StartupIntroStoryboard">
            <!-- FT Mark Opacity -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="IntroLogo" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.1" Value="0.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.45" Value="1.0" KeySpline="0.2,0,0.2,1" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.65" Value="1.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0.0" KeySpline="0.2,0,0.2,1" />
            </DoubleAnimationUsingKeyFrames>

            <!-- FT Mark Scale (96% -> 100%) -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="IntroScale" Storyboard.TargetProperty="ScaleX">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.96" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1.00" KeySpline="0.2,0,0.2,1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="IntroScale" Storyboard.TargetProperty="ScaleY">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.96" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1.00" KeySpline="0.2,0,0.2,1" />
            </DoubleAnimationUsingKeyFrames>

            <!-- Intro Veil Overlay Opacity (Reveals launcher underneath from 0.70s to 1.20s) -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="IntroOverlay" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="1.0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.70" Value="1.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.20" Value="0.0" KeySpline="0.2,0,0.2,1" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Utility Button Style -->
        <Style x:Key="UtilityButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#7E8E9F" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="2" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1AFFFFFF" />
                                <Setter Property="Foreground" Value="#E2E8F0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2AFFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Utility Button Style -->
        <Style x:Key="CloseUtilityButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#7E8E9F" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="2" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#997F1D1D" />
                                <Setter Property="Foreground" Value="#FECDD3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B9991B1B" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Link Button Style -->
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="txt" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="txt" Property="TextDecorations" Value="Underline" />
                                <Setter Property="Foreground" Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Launch Button Style (Authentic Stitch Tactile Play Button) -->
        <Style x:Key="LaunchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="280" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root">
                            <!-- Main Outer Border & Background Gradient -->
                            <Border x:Name="bgBorder" CornerRadius="2" BorderThickness="1" BorderBrush="#4DE5C378" SnapsToDevicePixels="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#1C2E46" Offset="0.0" />
                                        <GradientStop Color="#101B2B" Offset="0.55" />
                                        <GradientStop Color="#0B131F" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6" />
                                </Border.Effect>
                            </Border>

                            <!-- Top Gold Hairline Gradient -->
                            <Rectangle Height="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="1,1,1,0" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#00E5C378" Offset="0.0" />
                                        <GradientStop Color="#99E5C378" Offset="0.5" />
                                        <GradientStop Color="#00E5C378" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- Left Gold Bar Accent -->
                            <Rectangle Width="2" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="1,2,0,2" Fill="#80E5C378" IsHitTestVisible="False" />

                            <!-- Top-Right Corner Decorative Bracket -->
                            <Path HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,4,0" Data="M0,0 H8 V8" Stroke="#99E5C378" StrokeThickness="1" IsHitTestVisible="False" />

                            <!-- Bottom-Left Corner Decorative Bracket -->
                            <Path HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,0,3" Data="M0,8 H8 V0" Stroke="#99E5C378" StrokeThickness="1" IsHitTestVisible="False" />

                            <!-- Button Content -->
                            <ContentPresenter x:Name="content" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bgBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#243B5A" Offset="0.0" />
                                            <GradientStop Color="#152338" Offset="0.55" />
                                            <GradientStop Color="#0E1827" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bgBorder" Property="BorderBrush" Value="#99E5C378" />
                                <Setter TargetName="bgBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#7AA2CD" Opacity="0.3" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bgBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#0F1A28" Offset="0.0" />
                                            <GradientStop Color="#152233" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bgBorder" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Main Window Container with Atmospheric Drop Shadow -->
    <Border Margin="10" CornerRadius="3" Background="#060B14" BorderBrush="#CC1E2B3D" BorderThickness="1" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.95" />
        </Border.Effect>

        <Grid>
            <!-- LAYER 1: Background Cinematic Artwork -->
            <Image Source="pack://application:,,,/Assets/Backgrounds/launcher_bg.jpg" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />

            <!-- LAYER 2: Cinematic Vignette (Asymmetric Lighting Overlays) -->
            <!-- 2A. Radial Vignette: Darkens outer perimeter while keeping spires and sky brilliant -->
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.75,0.35" GradientOrigin="0.75,0.35" RadiusX="0.85" RadiusY="0.85">
                        <GradientStop Color="#00000000" Offset="0.35" />
                        <GradientStop Color="#73060B14" Offset="0.70" />
                        <GradientStop Color="#EB050911" Offset="1.0" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- 2B. Bottom Anchor Vignette: Creates deep moody contrast for control placement -->
            <Rectangle IsHitTestVisible="False" VerticalAlignment="Bottom" Height="260">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                        <GradientStop Color="#F8050911" Offset="0.0" />
                        <GradientStop Color="#D8050911" Offset="0.38" />
                        <GradientStop Color="#60060B14" Offset="0.75" />
                        <GradientStop Color="#00060B14" Offset="1.0" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- 2C. Left-to-Right Gradient: Anchors branding and bottom-left game status -->
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#99050911" Offset="0.0" />
                        <GradientStop Color="#33060B14" Offset="0.35" />
                        <GradientStop Color="#00000000" Offset="0.65" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- LAYER 3: TOP LAYER (Branding & Window Utility Controls) -->
            <Grid VerticalAlignment="Top" Margin="34,22,34,0" Background="Transparent" MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Top Left: Project Identity & Subtitle -->
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <!-- Custom Brand Wordmark: AION (White) + 2TR (Celestial Gold) -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="AION" FontFamily="{StaticResource BrandFont}" FontSize="24" FontWeight="Bold" Foreground="#F1F5F9">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.9" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="2TR" FontFamily="{StaticResource BrandFont}" FontSize="24" FontWeight="Bold" Foreground="#E5C378" Margin="2,0,0,0">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Direction="0" Color="#E5C378" Opacity="0.4" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>

                    <!-- Subtitle & Community Descriptor -->
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="TÜRKÇE YAMA" FontSize="11" FontWeight="Medium" Foreground="#CBD5E1" />
                        <Ellipse Width="3" Height="3" Fill="#566B82" Margin="8,0" VerticalAlignment="Center" />
                        <TextBlock Text="TOPLULUK PROJESİ" FontSize="11" Foreground="#6D8197" />
                    </StackPanel>
                </StackPanel>

                <!-- Top Right: Monochrome Minimal Utility Icons & Window Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <!-- GitHub Button -->
                    <Button Style="{StaticResource UtilityButtonStyle}" ToolTip="GitHub Sayfası" Command="{Binding OpenGitHubCommand}">
                        <Path Data="{StaticResource GithubIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform" />
                    </Button>

                    <!-- Logs Button -->
                    <Button Style="{StaticResource UtilityButtonStyle}" ToolTip="Günlüğü Görüntüle" Command="{Binding OpenLogsCommand}" Margin="2,0,0,0">
                        <Path Data="{StaticResource LogsIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15" Stretch="Uniform" />
                    </Button>

                    <!-- Settings Button -->
                    <Button Style="{StaticResource UtilityButtonStyle}" ToolTip="Ayarlar" Command="{Binding OpenSettingsCommand}" Margin="2,0,0,0">
                        <Path Data="{StaticResource SettingsIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15" Stretch="Uniform" />
                    </Button>

                    <!-- Vertical Divider -->
                    <Rectangle Width="1" Height="14" Fill="#FFFFFF" Opacity="0.1" Margin="6,0,6,0" VerticalAlignment="Center" />

                    <!-- Minimize Button -->
                    <Button Style="{StaticResource UtilityButtonStyle}" ToolTip="Küçült" Command="{Binding MinimizeCommand}">
                        <Path Data="{StaticResource MinimizeIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" />
                    </Button>

                    <!-- Close Button -->
                    <Button Style="{StaticResource CloseUtilityButtonStyle}" ToolTip="Kapat" Command="{Binding CloseCommand}" Margin="2,0,0,0">
                        <Path Data="{StaticResource CloseIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- LAYER 4: BOTTOM OVERLAY GRID (Firmly anchored to the bottom edge, responsive across scalings) -->
            <Grid VerticalAlignment="Bottom" Margin="34,0,34,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Subtle Architectural Separator Line -->
                <Rectangle Grid.Row="0" Height="1" Opacity="0.35" Margin="0,0,0,18">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#40E5C378" Offset="0.0" />
                            <GradientStop Color="#14FFFFFF" Offset="0.5" />
                            <GradientStop Color="#00000000" Offset="1.0" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Row 1: Left Status & Right Action Deck -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Group: Game Detection Status + Location Picker + Version Info + FT Brand Signature -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Orientation="Vertical">
                        <!-- Status Row -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Glowing Status Dot -->
                            <Grid Width="10" Height="10" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Opacity="0.4">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#10B981" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GameFound}" Value="False">
                                                    <Setter Property="Fill" Value="#EF4444" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Ellipse Width="6" Height="6">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#10B981" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GameFound}" Value="False">
                                                    <Setter Property="Fill" Value="#EF4444" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>

                            <!-- Game Detection Text -->
                            <TextBlock Text="{Binding GameStatusText}" FontSize="12" FontWeight="Medium" Foreground="#E2E8F0" Margin="8,0,0,0" VerticalAlignment="Center" />

                            <!-- Dot Separator -->
                            <TextBlock Text="•" FontSize="11" Foreground="#55697F" Margin="8,0" VerticalAlignment="Center" />

                            <!-- Change Location Button -->
                            <Button Style="{StaticResource LinkButtonStyle}" Content="{Binding GameLocationActionText}" Command="{Binding SelectGameFolderCommand}" FontSize="11" Foreground="#71879F" ToolTip="{Binding GamePath}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Version Row & FT Developer Signature -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,7,0,0">
                            <TextBlock Text="{Binding VersionRowText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#94A3B8" Opacity="0.8" VerticalAlignment="Center" />

                            <!-- Subtle Bullet Separator -->
                            <TextBlock Text="•" FontSize="10" Foreground="#475569" Margin="8,0" VerticalAlignment="Center" />

                            <!-- Subtle FT Developer Mark -->
                            <Image Source="pack://application:,,,/Assets/Branding/fute_mark.png" Width="12" Height="12" Opacity="0.65" VerticalAlignment="Center" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="FuTe" FontFamily="{StaticResource BrandFont}" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Opacity="0.75" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Right Group: Status/Version Badge + Action Button + Secondary Action Link -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Vertical">

                        <!-- Status & Version Badge Row -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                            <TextBlock Text="{Binding StatusDeckTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                            <Border Background="#131C29" BorderBrush="#4DE5C378" BorderThickness="1" CornerRadius="2" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PatchVersionText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#E5C378" />
                            </Border>
                        </StackPanel>

                        <!-- Thin Progress Indicator (Visible when Busy) -->
                        <StackPanel Margin="0,0,0,8" Width="280" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding BusyText}" FontSize="11" Foreground="#7AA2CD" TextAlignment="Right" Margin="0,0,0,4" />
                            <ProgressBar Height="3" Background="#101B2B" Foreground="#E5C378" BorderThickness="0" Value="{Binding ProgressValue}" IsIndeterminate="{Binding IsIndeterminateProgress}" />
                        </StackPanel>

                        <!-- Primary Action Button (Play / Install / Update / Repair) -->
                        <Button Style="{StaticResource LaunchButtonStyle}" Command="{Binding PrimaryActionCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- Play Triangle Icon (Shows when Primary is Play Action) -->
                                <Path Data="{StaticResource PlayIcon}" Fill="#E5C378" Width="14" Height="14" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"
                                      Visibility="{Binding IsPlayAction, Converter={StaticResource BoolToVis}}">
                                    <Path.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#E5C378" Opacity="0.6" />
                                    </Path.Effect>
                                </Path>

                                <!-- Button Text in Editorial MMORPG Style -->
                                <TextBlock Text="{Binding PrimaryButtonTextUpper}" FontFamily="{StaticResource BrandFont}" FontSize="15" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.9" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- Quiet Secondary Action: Remove Patch (Lowest item, right-aligned) -->
                        <Button Style="{StaticResource LinkButtonStyle}" Content="Yamayı Kaldır" Command="{Binding RemoveCommand}" FontSize="11" Foreground="#697E96" HorizontalAlignment="Right" Margin="0,8,4,0"
                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- LAYER 5: Refined Toast Notification (Top-Right under controls, non-blocking) -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,66,34,0" CornerRadius="4" Padding="14,9" MaxWidth="380"
                    Background="#E60D172A" BorderBrush="#4DE5C378" BorderThickness="1" SnapsToDevicePixels="True" IsHitTestVisible="False"
                    Visibility="{Binding ShowNotification, Converter={StaticResource BoolToVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.8" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="6" Height="6" Fill="#E5C378" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding NotificationMessage}" FontSize="11" Foreground="#F1F5F9" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- LAYER 6: Settings Modal Overlay (Styled to Celestial Navy & Gold Theme) -->
            <Grid Background="#CC040810" Visibility="{Binding ShowSettingsPopup, Converter={StaticResource BoolToVis}}">
                <Border Background="#0B1324" BorderBrush="#1E2B3D" BorderThickness="1" CornerRadius="4" Width="480" Height="340" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                    <Grid>
                        <!-- Top Hairline Gold Accent -->
                        <Rectangle Height="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="-24,-24,-24,0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#00E5C378" Offset="0.0" />
                                    <GradientStop Color="#99E5C378" Offset="0.5" />
                                    <GradientStop Color="#00E5C378" Offset="1.0" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <DockPanel>
                            <!-- Modal Header -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
                                <TextBlock Text="AYARLAR &amp; TANILAMA" FontFamily="{StaticResource BrandFont}" FontSize="15" FontWeight="Bold" Foreground="#F1F5F9" />
                                <Button Command="{Binding CloseSettingsCommand}" Style="{StaticResource UtilityButtonStyle}" HorizontalAlignment="Right">
                                    <Path Data="{StaticResource CloseIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" />
                                </Button>
                            </Grid>

                            <!-- Close Button Bottom -->
                            <Button DockPanel.Dock="Bottom" Command="{Binding CloseSettingsCommand}" Style="{StaticResource UtilityButtonStyle}" Background="#162235" Foreground="#E2E8F0" Content="Kapat" Width="90" Height="32" HorizontalAlignment="Right" />

                            <!-- Settings Body -->
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="AION2 Oyun Klasörü:" FontSize="12" Foreground="#8EA2B9" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding GamePath, Mode=OneWay}" Background="#060B14" Foreground="#E2E8F0" BorderBrush="#1E2B3D" Padding="8,6" FontSize="11" IsReadOnly="True" />
                                    <Button Grid.Column="1" Command="{Binding SelectGameFolderCommand}" Style="{StaticResource UtilityButtonStyle}" Background="#162235" Foreground="#E2E8F0" Content="Değiştir" Width="70" Height="28" Margin="8,0,0,0" />
                                </Grid>

                                <!-- Intro Animation Setting Toggle -->
                                <CheckBox IsChecked="{Binding ShowIntroAnimation}" Content="Açılış animasyonunu göster" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,16" Cursor="Hand" />

                                <TextBlock Text="Kayıtlar ve Tanılama:" FontSize="12" Foreground="#8EA2B9" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Button Command="{Binding OpenLogsCommand}" Style="{StaticResource UtilityButtonStyle}" Background="#162235" Foreground="#E2E8F0" Content="Günlüğü Aç" Width="100" Height="28" Margin="0,0,10,0" />
                                    <Button Command="{Binding OpenLogFolderCommand}" Style="{StaticResource UtilityButtonStyle}" Background="#162235" Foreground="#E2E8F0" Content="Kayıt Klasörü" Width="100" Height="28" />
                                </StackPanel>

                                <TextBlock Text="AION2TR V2 mimarisi güvenli işlem anlık görüntüleri ve otomatik geri yükleme koruması içerir." FontSize="11" Foreground="#55697F" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- LAYER 7: Startup Intro Animation Overlay (ZIndex 100, fades out smoothly in 1.2s) -->
            <Grid x:Name="IntroOverlay" Background="#060B14" Panel.ZIndex="100" IsHitTestVisible="False">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image x:Name="IntroLogo" Source="pack://application:,,,/Assets/Branding/fute_mark_gold.png" Width="96" Height="96" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="IntroScale" ScaleX="0.96" ScaleY="0.96" />
                        </Image.RenderTransform>
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#E5C378" Opacity="0.4" />
                        </Image.Effect>
                    </Image>
                </Grid>
            </Grid>

        </Grid>
    </Border>
</Window>
